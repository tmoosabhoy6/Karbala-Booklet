// Cloudflare: a Worker in front of one container that runs the repository's
// Dockerfile (the same image Render ran). Deploy from this folder with
// `npm ci && npm run deploy` (needs Docker; see the README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karbala-booklet",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Booklet",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // 4 GiB memory, 1/2 vCPU, 8 GB disk: Chromium prints the PDF and sharp
      // and OCR clean screenshots, which ran a 512 MB host out of memory.
      "instance_type": "standard-1",
      // One server holds the open booklet and its files, as on Render.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BOOKLET", "class_name": "Booklet" },
      // The app's files (src/store.ts), reached by the container as STORE_URL.
      { "name": "STORE", "class_name": "Store" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Booklet"] },
    { "tag": "v2", "new_sqlite_classes": ["Store"] }
  ],
  "vars": {
    // The server keeps its files in the Store Durable Object (src/store.ts),
    // which only the container reaches, at this address.
    "STORE_URL": "http://store.internal",
    // Used instead only when STORE_URL is removed and GITHUB_STORAGE_TOKEN is set.
    "GITHUB_STORAGE_REPO": "tmoosabhoy6/Karbala-Booklet"
  }
}
