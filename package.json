{
  "name": "karbala-booklet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "verify": "npm run build && tsx tools/verify.ts",
    "dev": "concurrently -k -n server,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "assets": "node tools/build-logos.mjs",
    "verify:lettering": "tsx tools/verify-lettering.ts"
  },
  "dependencies": {
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/urd": "^1.0.0",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.48.2",
    "potrace": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
